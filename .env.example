# --- Embeddings ---------------------------------------------------------------
# "hash" = mode développement hors-ligne (ne comprend PAS le sens, seulement les mots communs).
# Pour la vraie qualité : sentence-transformers + pip install -r requirements-ml.txt
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Génération ---------------------------------------------------------------
# auto = Claude si ANTHROPIC_API_KEY est défini, sinon réponses extractives (sans LLM)
LLM_BACKEND=auto
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- Général ------------------------------------------------------------------
DATA_DIR=./data
# Fuseau qui sert à comprendre "hier", "aujourd'hui", "cette semaine"
TIMEZONE=Africa/Lagos

# --- Réglages de récupération (à ajuster avec scripts/evaluate.py) -------------
TOP_K=6
MIN_SCORE=0.15
CONFIDENT_SCORE=0.30

# --- Sécurité (Rosine) --------------------------------------------------------
# Laisser vide = pas d'authentification (développement uniquement).
API_KEY=
INGEST_API_KEY=
CORS_ORIGINS=
